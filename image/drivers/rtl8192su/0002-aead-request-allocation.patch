From 1f09c7a6eceffc92e63ddc636c174e8f3770eeb9 Mon Sep 17 00:00:00 2001
Subject: [PATCH] allocate AEAD requests safely and fail closed

Replace runtime-sized stack allocations with the crypto API allocator. Propagate
CCMP encryption failures so the transmit path drops the packet.

---
diff --git a/aes_ccm.c b/aes_ccm.c
index 3de17b1..fd75bfa 100644
--- a/aes_ccm.c
+++ b/aes_ccm.c
@@ -91,7 +91,7 @@ static void ccmp_special_blocks(struct ieee80211_hdr *hdr, size_t hdrlen,
 	}
 }
 
-void ieee80211_aes_ccm_encrypt(struct crypto_aead *tfm, struct sk_buff *skb,
+int ieee80211_aes_ccm_encrypt(struct crypto_aead *tfm, struct sk_buff *skb,
 			       const u64 pn, size_t mic_len)
 {
 	u8 aad[2 * AES_BLOCK_SIZE];
@@ -100,16 +100,17 @@ void ieee80211_aes_ccm_encrypt(struct crypto_aead *tfm, struct sk_buff *skb,
 	size_t data_len, hdr_len;
 	struct ieee80211_hdr *hdr = (void *)skb->data;
 	struct scatterlist sg[3];
-	char aead_req_data[sizeof(struct aead_request) +
-			   crypto_aead_reqsize(tfm)]
-		__aligned(__alignof__(struct aead_request));
-	struct aead_request *aead_req = (void *) aead_req_data;
+	struct aead_request *aead_req;
+	size_t skb_len = skb->len;
+	int err;
 
 	hdr_len = ieee80211_hdrlen(hdr->frame_control);
 	data_len = skb->len - hdr_len - IEEE80211_CCMP_HDR_LEN;
 	ccmp_special_blocks(hdr, hdr_len, pn, b_0, aad);
 
-	memset(aead_req, 0, sizeof(aead_req_data));
+	aead_req = aead_request_alloc(tfm, GFP_ATOMIC);
+	if (!aead_req)
+		return -ENOMEM;
 
 	data = skb->data + hdr_len + IEEE80211_CCMP_HDR_LEN;
 	mic = skb_put(skb, mic_len);
@@ -122,7 +123,12 @@ void ieee80211_aes_ccm_encrypt(struct crypto_aead *tfm, struct sk_buff *skb,
 	aead_request_set_crypt(aead_req, sg, sg, data_len, b_0);
 	aead_request_set_ad(aead_req, sg[0].length);
 
-	crypto_aead_encrypt(aead_req);
+	err = crypto_aead_encrypt(aead_req);
+	aead_request_free(aead_req);
+	if (err)
+		skb_trim(skb, skb_len);
+
+	return err;
 }
 
 int ieee80211_aes_ccm_decrypt(struct crypto_aead *tfm, struct sk_buff *skb,
@@ -134,10 +140,8 @@ int ieee80211_aes_ccm_decrypt(struct crypto_aead *tfm, struct sk_buff *skb,
 	size_t data_len, hdr_len;
 	struct ieee80211_hdr *hdr = (void *)skb->data;
 	struct scatterlist sg[3];
-	char aead_req_data[sizeof(struct aead_request) +
-			   crypto_aead_reqsize(tfm)]
-		__aligned(__alignof__(struct aead_request));
-	struct aead_request *aead_req = (void *) aead_req_data;
+	struct aead_request *aead_req;
+	int err;
 
 	hdr_len = ieee80211_hdrlen(hdr->frame_control);
 	data_len = skb->len - hdr_len - mic_len;
@@ -147,7 +151,9 @@ int ieee80211_aes_ccm_decrypt(struct crypto_aead *tfm, struct sk_buff *skb,
 
 	ccmp_special_blocks(hdr, hdr_len, pn, b_0, aad);
 
-	memset(aead_req, 0, sizeof(aead_req_data));
+	aead_req = aead_request_alloc(tfm, GFP_ATOMIC);
+	if (!aead_req)
+		return -ENOMEM;
 	mic = skb->data + skb->len - mic_len;
 	data = skb->data + hdr_len;
 	sg_init_table(sg, 3);
@@ -159,7 +165,9 @@ int ieee80211_aes_ccm_decrypt(struct crypto_aead *tfm, struct sk_buff *skb,
 	aead_request_set_crypt(aead_req, sg, sg, data_len + mic_len, b_0);
 	aead_request_set_ad(aead_req, sg[0].length);
 
-	return crypto_aead_decrypt(aead_req);
+	err = crypto_aead_decrypt(aead_req);
+	aead_request_free(aead_req);
+	return err;
 }
 
 struct crypto_aead *ieee80211_aes_key_setup_encrypt(const u8 key[],
diff --git a/aes_ccm.h b/aes_ccm.h
index 2901043..4c39bdb 100644
--- a/aes_ccm.h
+++ b/aes_ccm.h
@@ -15,7 +15,7 @@ void ieee80211_aes_key_free(struct crypto_aead *tfm);
 int ieee80211_aes_ccm_decrypt(struct crypto_aead *tfm, struct sk_buff *skb,
 			      const u64 pn, size_t mic_len);
 
-void ieee80211_aes_ccm_encrypt(struct crypto_aead *tfm, struct sk_buff *skb,
+int ieee80211_aes_ccm_encrypt(struct crypto_aead *tfm, struct sk_buff *skb,
 			       const u64 pn, size_t mic_len);
 
 #endif /* AES_CCM_H */
diff --git a/tx.c b/tx.c
index 997c36c..f1eff4d 100644
--- a/tx.c
+++ b/tx.c
@@ -274,11 +274,10 @@ r92su_tx_add_crypto(struct r92su *r92su, struct sk_buff *skb,
 		}
 
 	case AESCCMP_ENCRYPTION:
-		if (tx_info->needs_encrypt) {
-			ieee80211_aes_ccm_encrypt(key->ccmp.tfm, skb,
-						  tx_info->pn,
-						  IEEE80211_CCMP_MIC_LEN);
-		}
+		if (tx_info->needs_encrypt &&
+		    ieee80211_aes_ccm_encrypt(key->ccmp.tfm, skb, tx_info->pn,
+					      IEEE80211_CCMP_MIC_LEN))
+			return TX_DROP;
 		break;
 
 	default:
