From 1f09c7a6eceffc92e63ddc636c174e8f3770eeb9 Mon Sep 17 00:00:00 2001
Subject: [PATCH] update timer callbacks and monotonic time reads

Linux removed setup_timer() and the old timespec/ktime_get_ts() interface.
Use timer_setup() and ktime_get_seconds() instead.

---
diff --git a/rx.h b/rx.h
index 1f4735d..5f9dbf4 100644
--- a/rx.h
+++ b/rx.h
@@ -31,6 +31,7 @@
 
 #include <linux/mm.h>
 #include <linux/skbuff.h>
+#include <linux/timer.h>
 
 #include "r92su.h"
 
@@ -42,7 +43,7 @@ void r92su_rx_deinit(struct r92su *r92su);
 u8 *r92su_find_ie(u8 *ies, const u32 len, const u8 ie);
 
 
-void r92su_reorder_tid_timer(unsigned long arg);
+void r92su_reorder_tid_timer(struct timer_list *timer);
 void r92su_rx(struct r92su *r92su, void *skb, const unsigned int len);
 
 #endif /* __R92SU_RX_H__ */
diff --git a/rx.c b/rx.c
index c57a537..f36a297 100644
--- a/rx.c
+++ b/rx.c
@@ -1084,10 +1084,10 @@ rx_drop:
 #undef RX_HANDLER
 }
 
-void r92su_reorder_tid_timer(unsigned long arg)
+void r92su_reorder_tid_timer(struct timer_list *timer)
 {
 	struct sk_buff_head frames;
-	struct r92su_rx_tid *tid;
+	struct r92su_rx_tid *tid = from_timer(tid, timer, reorder_timer);
 	struct r92su *r92su;
 	struct r92su_sta *sta;
 	struct cfg80211_bss *bss;
@@ -1096,7 +1096,6 @@ void r92su_reorder_tid_timer(unsigned long arg)
 	__skb_queue_head_init(&frames);
 
 	rcu_read_lock();
-	tid = (struct r92su_rx_tid *) arg;
 	r92su = tid->r92su;
 	sta = tid->sta;
 
diff --git a/sta.c b/sta.c
index 5fc3c2a..e829cae 100644
--- a/sta.c
+++ b/sta.c
@@ -30,6 +30,7 @@
 #include <linux/kernel.h>
 #include <linux/workqueue.h>
 #include <linux/random.h>
+#include <linux/timekeeping.h>
 #include "r92su.h"
 #include "aes_ccm.h"
 #include "tkip.h"
@@ -105,9 +106,7 @@ void r92su_sta_alloc_tid(struct r92su *r92su,
 		spin_lock_init(&new_tid->lock);
 		new_tid->tid = tid;
 
-		setup_timer(&new_tid->reorder_timer,
-			    r92su_reorder_tid_timer,
-		    (unsigned long) new_tid);
+		timer_setup(&new_tid->reorder_timer, r92su_reorder_tid_timer, 0);
 		new_tid->r92su = r92su;
 		new_tid->sta = sta;
 		new_tid->head_seq = new_tid->ssn = ssn >> 4;
@@ -130,7 +129,7 @@ struct r92su_sta *r92su_sta_alloc(struct r92su *r92su, const u8 *mac_addr,
 	sta = kzalloc(sizeof(*sta), flag);
 	if (sta) {
 		unsigned long flags;
-		struct timespec uptime;
+		u64 uptime;
 		int i;
 
 		for (i = 0; i < ARRAY_SIZE(sta->defrag); i++)
@@ -141,8 +140,7 @@ struct r92su_sta *r92su_sta_alloc(struct r92su *r92su, const u8 *mac_addr,
 		sta->mac_id = mac_id;
 		sta->aid = aid;
 
-		ktime_get_ts(&uptime);
-		sta->last_connected = uptime.tv_sec;
+		sta->last_connected = ktime_get_seconds();
 
 		/* Remove the old station */
 		r92su_sta_del(r92su, mac_id);
@@ -293,6 +291,6 @@ void r92su_sta_set_sinfo(struct r92su *r92su, struct r92su_sta *sta,
 				 struct station_info *sinfo)
 {
-	struct timespec uptime;
+	u64 uptime;
 	struct cfg80211_bss *bss;
 	struct r92su_bss_priv *bss_priv;
 	sinfo->generation = r92su->sta_generation;
@@ -303,8 +301,8 @@ void r92su_sta_set_sinfo(struct r92su *r92su, struct r92su_sta *sta,
 			BIT(NL80211_STA_INFO_STA_FLAGS) |
 			BIT(NL80211_STA_INFO_SIGNAL);
 
-	ktime_get_ts(&uptime);
-	sinfo->connected_time = uptime.tv_sec - sta->last_connected;
+	uptime = ktime_get_seconds();
+	sinfo->connected_time = uptime - sta->last_connected;
 	sinfo->signal = sta->signal;
 	sinfo->rxrate.flags = sta->last_rx_rate_flag;
 	sinfo->rxrate.bw = sta->last_rx_rate_bw;
