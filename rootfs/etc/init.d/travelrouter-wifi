#!/sbin/openrc-run
# OpenRC reads this metadata even though the shell script does not.
# shellcheck disable=SC2034
description="Load the experimental RTL8191SU USB Wi-Fi driver"

depend() {
    need localmount
    after modloop
    before networkmanager
}

start() {
    module=/opt/travelrouter/modules/r92su.ko
    if [ ! -s "$module" ]; then
        ebegin "No optional RTL8191SU module for this image target"
        eend 0
        return 0
    fi

    ebegin "Loading dependencies for the experimental RTL8191SU module"
    dependencies=$(modinfo -F depends "$module") || {
        eend 1
        return 1
    }
    dependencies=$(printf '%s' "$dependencies" | tr ',' ' ')
    # The modinfo field is a comma-separated list and needs intentional splitting.
    # shellcheck disable=SC2086
    for dependency in $dependencies; do
        modprobe "$dependency" || {
            eend 1
            return 1
        }
    done
    eend 0

    if [ ! -d /sys/module/r92su ]; then
        ebegin "Loading the experimental RTL8191SU module"
        insmod "$module" || {
            eend 1
            return 1
        }
        eend 0
        return 0
    fi
    eend 0
}
